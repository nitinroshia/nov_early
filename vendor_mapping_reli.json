  "known_issues": [
    {
      "id": "unit_payout_fraction",
      "severity": "high",
      "codes": [
        "incPyr"
      ],
      "finding": "Payout ratio is a fraction (0.24) while every other ratio is in percent points.",
      "handling": "Mapping multiplies by 100; generator should emit percent points."
    },
    {
      "id": "nca_excludes_other",
      "severity": "high",
      "codes": [
        "balNca",
        "balOtha"
      ],
      "finding": "balNca excludes balOtha, yet total assets include both.",
      "handling": "Mapping sums them into total_non_current_assets."
    },
    {
      "id": "ocl_includes_std",
      "severity": "high",
      "codes": [
        "balOcl"
      ],
      "finding": "balOcl contains short-term debt as well as other current liabilities.",
      "handling": "Synthetic mapping splits it using balTdeb - balTltd."
    },
    {
      "id": "cash_flow_sign",
      "severity": "medium",
      "codes": [
        "cafCexp",
        "cafTcdp"
      ],
      "finding": "Capex and dividends paid are positive while investing/financing totals are signed.",
      "handling": "Mapping negates them (cash-effect sign convention)."
    },
    {
      "id": "earnings_code",
      "severity": "medium",
      "codes": [
        "earnings"
      ],
      "finding": "Code 'earnings' is the 5-year CAGR of EBITDA, not earnings.",
      "handling": "Mapped to ebitda_cagr_5y."
    },
    {
      "id": "opex_name_collision",
      "severity": "medium",
      "codes": [
        "incOpe",
        "qIncOpeK"
      ],
      "finding": "incOpe is the residual 'other operating expense'; qIncOpeK is total opex.",
      "handling": "Different canonical fields."
    },
    {
      "id": "roic_capital_definition",
      "severity": "medium",
      "codes": [
        "aroi",
        "evByIc"
      ],
      "finding": "ROIC divides by gross capital; EV/IC uses capital net of cash.",
      "handling": "Both kept; definitions documented. Pick one."
    },
    {
      "id": "iso_midnight_utc",
      "severity": "medium",
      "codes": [
        "endDate"
      ],
      "finding": "Date-only values are emitted as midnight UTC timestamps.",
      "handling": "Mapping converts to plain dates."
    },
    {
      "id": "peer_inconsistency",
      "severity": "medium",
      "codes": [
        "epsg",
        "12mVol",
        "beta",
        "qcur",
        "aint",
        "ccnc"
      ],
      "finding": "Peer snapshots are not derived from peer histories: epsg is net-income growth, risk uses monthly returns, and qcur/aint/ccnc are random.",
      "handling": "Replace with the shared company engine (next step)."
    },
    {
      "id": "market_cap_label",
      "severity": "medium",
      "codes": [
        "marketCapLabel"
      ],
      "finding": "Fixed Rs 20,000 cr threshold; Indian practice is the AMFI rank-based list.",
      "handling": "Mapped to rank-based enum; generator should rank within a universe."
    },
    {
      "id": "consensus_hardcoded",
      "severity": "low",
      "codes": [
        "breco",
        "summary.forecast.totalReco",
        "summary.forecast.percBuyReco"
      ],
      "finding": "Recommendation figures are constants for the subject and random for peers.",
      "handling": "Model consensus properly when the estimates domain is built."
    },
    {
      "id": "duplicate_aliases",
      "severity": "low",
      "codes": [
        "balCa",
        "3mAvgVol",
        "pe",
        "pb",
        "mrktCapf",
        "info.ratios.risk",
        "bps",
        "divYield",
        "bookValue"
      ],
      "finding": "Several codes duplicate others under a different name.",
      "handling": "Mapped to the same canonical field; drop duplicates at the source."
    },
    {
      "id": "market_cap_share_basis",
      "severity": "low",
      "codes": [
        "marketCap",
        "ev"
      ],
      "finding": "Market cap uses fiscal-year share count; EV omits minority interest and investments.",
      "handling": "Documented in field notes."
    },
    {
      "id": "ttm_dividend",
      "severity": "low",
      "codes": [
        "incDps",
        "incPyr"
      ],
      "finding": "TTM row takes dividend from the latest fiscal year, not trailing quarters.",
      "handling": "Flag when rebuilding TTM."
    },
    {
      "id": "rounding",
      "severity": "low",
      "codes": [],
      "finding": "Output is rounded to 2 decimals, which loses precision for small ratios and betas.",
      "handling": "Store full precision; round at presentation."
    },
    {
      "id": "calendar_approx",
      "severity": "low",
      "codes": [],
      "finding": "Trading calendar uses a handful of fixed-date holidays, no Muhurat/special sessions.",
      "handling": "Use the trading_calendar entity with the real exchange list."
    }
  ]
